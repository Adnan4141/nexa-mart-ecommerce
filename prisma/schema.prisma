datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  BKASH
  PAYONEER
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String?
  phone            String?
  image            String?
  role             Role              @default(CUSTOMER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  wishlistItems    WishlistItem[]
  deliveryBookings DeliveryBooking[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  price         Float
  originalPrice Float?
  discount      String?
  badge         String?
  rating        Float          @default(5.0)
  reviewsCount  Int            @default(0)
  imageUrl      String
  images        String[]       @default([])
  stock         Int            @default(50)
  isFeatured    Boolean        @default(false)
  isWeeklyDeal  Boolean        @default(false)
  isBestSeller  Boolean        @default(false)
  isPopular     Boolean        @default(false)
  categorySlug  String
  category      Category       @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String?
  subtotal        Float
  shippingFee     Float          @default(0.0)
  discountAmount  Float          @default(0.0)
  totalAmount     Float
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus  @default(UNPAID)
  couponCode      String?
  items           OrderItem[]
  trackingEvents  OrderTracking[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)
  unitPrice Float
  subtotal  Float
}

model OrderTracking {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String?
  location    String?
  createdAt   DateTime    @default(now())
}

model DeliveryBooking {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  phone            String
  deliveryDate     DateTime
  deliveryTimeSlot String
  deliveryAddress  String
  status           String   @default("CONFIRMED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Float
  isPercent Boolean   @default(true)
  minSpend  Float?
  validTill DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}
